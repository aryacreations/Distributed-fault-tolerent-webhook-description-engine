PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/webhook_dispatcher?retryWrites=true&w=majority

# Redis Connection (Upstash Redis TLS connection or local redis://localhost:6379)
REDIS_URL=rediss://default:token@bursting-tortoise-138365.upstash.io:6379

# Engine Configuration
RATE_LIMIT_PER_SECOND_PER_DOMAIN=5
DISPATCH_TIMEOUT_MS=5000
MAX_RETRIES=3
